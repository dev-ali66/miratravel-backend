model Joruneys {
    id                  String              @id @default(cuid())
    destinationId       String?
    name                String
    slug                String              @unique
    text                String
    location            String
    url                 String
    destinationImages   String[]
    destinationVideos   String[]
    isFeatured          Boolean             @default(false)
    createdAt           DateTime            @default(now())
    updatedAt           DateTime            @updatedAt
    journeysHeading     JourneysHeading?
    journeysOverviews   JourneysOverview[]
    journeysItineraries JourneysItinerary[]
    journeysIncludes    JourneysIncludes[]
    journeysPricing     JourneysPricing?
    reservations        Reservation[]
    wishlists           Wishlist[]
    destination         Destinations?        @relation(fields: [destinationId], references: [id])

    @@index([name])
    @@index([slug])
}

model JourneysHeading {
    id                           String   @id @default(cuid())
    journeyId                    String   @unique
    order                        Int?
    key                          String?
    title                        String?
    subTitle                     String?
    h1                           String?
    h2                           String?
    text                         String?
    features                     String[]
    small                        String?
    button                       String?
    buttonUrl                    String?
    maxGuest                     Int
    journeysHeadingSectionImages String[]
    journeysHeadingSectionVideos String[]
    data                         Json?
    isPublished                  Boolean  @default(false)
    createdAt                    DateTime @default(now())
    updatedAt                    DateTime @updatedAt
    journey                      Joruneys @relation(fields: [journeyId], references: [id])

    @@unique([journeyId, order])
}

