model Destinations {
    id                String     @id @default(cuid())
    name              String     @unique
    slug              String     @unique
    text              String?
    url               String?
    destinationImages String[]
    destinationVideos String[]
    createdAt         DateTime   @default(now())
    updatedAt         DateTime   @updatedAt
    joruneys          Joruneys[]

    @@index([name])
    @@index([slug])
}
