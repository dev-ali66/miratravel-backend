model Wishlist {
    id        String   @id @default(cuid())
    authId    String
    journeyId String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    user      Auth     @relation(fields: [authId], references: [id], onDelete: Cascade)
    journey   Joruneys @relation(fields: [journeyId], references: [id])

    @@unique([authId, journeyId])
}
