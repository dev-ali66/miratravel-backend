model JourneyWizardRequest {
    id           String   @id @default(cuid())
    journeyTypes String[]
    travelStyles String[]
    perfectFor   String[]
    pace         String?
    comfortLevel String?
    duration     String?
    budget       Int?
    budgetText   String?

    name   String?
    email  String?
    phone  String?
    notes  String? @db.Text
    status String  @default("NEW")

    deletedAt DateTime?
    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt

    @@index([status])
    @@index([createdAt])
}
