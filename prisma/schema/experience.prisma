enum ExperienceType {
    CULTURE_HERITAGE
    NATURE_WILDLIFE
    ADVENTURE_OUTDOORS
    FOOD_WINE
    LOCAL_LIFE_TRADITIONS
    ART_ARCHITECTURE
    COASTAL_MARITIME
    WELLNESS_SLOW_LIVING
}

model Experience {
    id             String           @id @default(cuid())
    name           String
    slug           String           @unique
    status         JourneyStatus    @default(DRAFT)
    featured       Boolean          @default(false)

    // Classification (Primary Type, Secondary Types, Tags/Attributes)
    primaryType    ExperienceType   @default(CULTURE_HERITAGE)
    secondaryTypes ExperienceType[]
    attributes     String[]

    // Commercial & Pricing
    price          Decimal          @default(0.00) @db.Decimal(10, 2)
    currency       String           @default("EUR")
    priceType      String?

    // Geography Linking (Countries, Regions, Places)
    countries      Location[]       @relation("ExperienceCountry")
    regions        Location[]       @relation("ExperienceRegion")
    places         Location[]       @relation("ExperiencePlace")

    // Content Sections & Editorial Detail
    subtitle       String?
    summary        String?
    theExperience  Json?
    highlights     Json?
    practicalInfo  Json?
    miraTouch      Json?
    enquiryCta     Json?

    // Legacy & CMS Modules
    geoData        Json?
    metadata       Json?
    hero           Json?
    essence        Json?
    faq            Json?
    gallery        Json?

    // Relations
    journeys       Journey[]        @relation("JourneyAddOns")
    stories        Story[]

    deletedAt      DateTime?
    createdAt      DateTime         @default(now())
    updatedAt      DateTime         @updatedAt

    @@index([price])
    @@index([status])
    @@index([primaryType])
}
