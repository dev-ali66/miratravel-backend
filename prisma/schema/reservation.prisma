model Reservation {
    id             String   @id @default(cuid())
    authId         String
    joruneyId      String
    firstName      String
    lastName       String
    email          String
    phone          String
    arrivalDate    DateTime
    departureDate  DateTime
    groupType      String
    groupInfo      String
    specialRequest String
    createdAt      DateTime @default(now())
    updatedAt      DateTime @updatedAt
    user           Auth     @relation(fields: [authId], references: [id], onDelete: Cascade)
    journey        Joruneys @relation(fields: [joruneyId], references: [id])
}
