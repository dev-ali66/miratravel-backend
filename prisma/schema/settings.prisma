model SiteSettings {
  id                    String    @id @default("global") // Singleton enforcement
  
  // GENERAL
  siteName              String?
  siteTagline           String?
  siteDescription       String?   @db.Text
  siteLogo              String?
  siteLogoLight         String?
  siteLogoDark          String?
  siteFavicon           String?
  siteUrl               String?
  defaultLanguage       String?   @default("en")
  defaultTimezone       String?   @default("UTC")
  contactEmail          String?
  supportEmail          String?
  phoneNumber           String?
  secondaryPhoneNumber  String?
  businessName          String?
  businessAddress       String?   @db.Text
  copyrightText         String?
  socialLinks           Json?     @default("[]")

  // SEO
  seoDefaultTitle       String?
  seoTitleTemplate      String?
  seoMetaDescription    String?   @db.Text
  seoKeywords           String?
  seoCanonicalUrl       String?
  seoOgTitle            String?
  seoOgDescription      String?   @db.Text
  seoOgImage            String?
  seoTwitterTitle       String?
  seoTwitterDescription String?   @db.Text
  seoTwitterImage       String?
  seoTwitterCard        String?
  seoRobots             String?   @default("index, follow")
  seoAuthor             String?
  seoGoogleVerification String?
  seoBingVerification   String?
  seoSchemaEnabled      Boolean   @default(true)

  updatedAt             DateTime  @updatedAt
  createdAt             DateTime  @default(now())
}
