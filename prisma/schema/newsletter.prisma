model NewsletterSubscriber {
  id        String    @id @default(cuid())
  email     String    @unique
  status    String    @default("SUBSCRIBED")
  source    String?   @default("FOOTER")
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([status])
  @@index([createdAt])
}
