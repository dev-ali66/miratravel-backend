model Story {
  id                   String          @id @default(cuid()) // Matching Location architecture
  slug                 String          @unique
  title                String
  categories           StoryCategory[]
  type                 String          @default("short_story") // short_story, long_story, guidance
  readTime             String?
  authorName           String?
  authorRole           String?
  authorAvatar         Json? // Universal Multimedia Object
  status               String          @default("DRAFT") // DRAFT, PUBLISHED
  featured             Boolean         @default(false)
  recommended          Boolean         @default(false)
  data                 Json? // Combined/legacy payload fallback
  hero                 Json?
  intro                Json?
  blocks               Json? // Dynamic blocks (paragraph, quote, image, etc.)
  practicalNotes       Json? // Travel notes for Guidance
  seo                  Json?
  journeys             Journey[]
  locations            Location[]
  manualRelatedStories Story[]         @relation("StoryToRelatedStories")
  relatedFromStories   Story[]         @relation("StoryToRelatedStories")
  deletedAt            DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@index([type])
  @@index([status])
}

model StoryCategory {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  stories   Story[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StoryType {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
