model Story {
  id           String    @id @default(cuid()) // Matching Location architecture
  slug         String    @unique
  title        String
  
  // -- Categories & Types --
  categories   StoryCategory[]
  type         String    @default("short_story") // short_story, long_story, guidance
  
  // -- Read Time --
  readTime     String?
  
  authorName   String?
  authorRole   String?
  authorAvatar Json?     // Universal Multimedia Object
  status       String    @default("DRAFT")       // DRAFT, PUBLISHED
  
  // -- Dual Payload Architecture --
  data         Json?     // Combined/legacy payload fallback

  // -- Modular Section Fields (JSON) --
  hero             Json? 
  intro            Json?
  blocks           Json? // Dynamic blocks (paragraph, quote, image, etc.)
  practicalNotes   Json? // Travel notes for Guidance
  seo              Json? 
  
  // -- Relation & Linking Arrays --
  journeyIds            String[] @default([]) // Array of related Journey IDs
  locationIds           String[] @default([]) // Array of related Location IDs
  manualRelatedStoryIds String[] @default([]) 

  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([type])
  @@index([status])
}

model StoryCategory {
  id        String    @id @default(uuid())
  name      String    @unique
  slug      String    @unique
  stories   Story[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model StoryType {
  id        String    @id @default(uuid())
  name      String    @unique
  slug      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}
