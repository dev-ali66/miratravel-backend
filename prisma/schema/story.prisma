model Story {
  id                   String          @id @default(cuid()) // Matching Location architecture
  slug                 String          @unique
  title                String
  categories           StoryCategory[]
  type                 String          @default("normal_story") // travel_ease, mira_editorial, normal_story
  readTime             String?
  authorName           String?
  authorRole           String?
  status               String          @default("DRAFT") // DRAFT, PUBLISHED
  featured             Boolean         @default(false)
  recommended          Boolean         @default(false)
  hero                 Json?
  intro                Json? // Deprecated: removed from form
  blocks               Json? // Dynamic blocks (paragraph, quote, image, video, notes, etc.)
  seo                  Json?
  journeys             Journey[]
  locations            Location[]
  experiences          Experience[]
  manualRelatedStories Story[]         @relation("StoryToRelatedStories")
  relatedFromStories   Story[]         @relation("StoryToRelatedStories")
  deletedAt            DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@index([type])
  @@index([status])
}

model StoryCategory {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  stories   Story[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StoryType {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
