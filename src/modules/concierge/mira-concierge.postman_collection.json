{
	"info": {
		"_postman_id": "mira-concierge-collection-v1",
		"name": "mira-concierge",
		"description": "Postman API Collection for Mira Concierge Module (/api/v1/concierge/leads). Handles lead submissions, concierge requests, and trip design inquiries.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:5010/api/v1",
			"type": "string"
		},
		{
			"key": "token",
			"value": "YOUR_JWT_ACCESS_TOKEN_HERE",
			"type": "string"
		}
	],
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{token}}",
				"type": "string"
			}
		]
	},
	"item": [
		{
			"name": "GET Concierge Leads (/concierge/leads)",
			"request": {
				"method": "GET",
				"header": [
					{ "key": "Accept", "value": "application/json" }
				],
				"url": {
					"raw": "{{base_url}}/concierge/leads",
					"host": [ "{{base_url}}" ],
					"path": [ "concierge", "leads" ]
				},
				"description": "Fetches submitted concierge inquiry leads."
			},
			"response": []
		},
		{
			"name": "POST Submit Lead (/concierge/leads)",
			"request": {
				"auth": { "type": "noauth" },
				"method": "POST",
				"header": [
					{ "key": "Content-Type", "value": "application/json" },
					{ "key": "Accept", "value": "application/json" }
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"fullName\": \"Jane Smith\",\n  \"email\": \"janesmith@example.com\",\n  \"phone\": \"+44 123 456 7890\",\n  \"destination\": \"Albania\",\n  \"travelDates\": \"May 2026\",\n  \"guests\": \"2 Adults\",\n  \"message\": \"Looking for a private tailor-made luxury coastal voyage.\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/concierge/leads",
					"host": [ "{{base_url}}" ],
					"path": [ "concierge", "leads" ]
				},
				"description": "Submits a new concierge lead inquiry from frontend."
			},
			"response": []
		},
		{
			"name": "DELETE Lead (/concierge/leads)",
			"request": {
				"method": "DELETE",
				"header": [
					{ "key": "Content-Type", "value": "application/json" },
					{ "key": "Accept", "value": "application/json" }
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"id\": \"cm_lead_id_here\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/concierge/leads",
					"host": [ "{{base_url}}" ],
					"path": [ "concierge", "leads" ]
				},
				"description": "Deletes lead record by ID."
			},
			"response": []
		}
	]
}
