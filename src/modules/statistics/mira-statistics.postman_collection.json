{
	"info": {
		"_postman_id": "mira-statistics-collection-v1",
		"name": "mira-statistics",
		"description": "Postman API Collection for Mira Statistics Module (/api/v1/statistics). Provides analytics, dashboard KPIs, booking metrics, and lead conversions.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:5010/api/v1",
			"type": "string"
		},
		{
			"key": "token",
			"value": "YOUR_JWT_ACCESS_TOKEN_HERE",
			"type": "string"
		}
	],
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{token}}",
				"type": "string"
			}
		]
	},
	"item": [
		{
			"name": "GET Statistics Summary (/statistics)",
			"request": {
				"method": "GET",
				"header": [
					{ "key": "Accept", "value": "application/json" }
				],
				"url": {
					"raw": "{{base_url}}/statistics",
					"host": [ "{{base_url}}" ],
					"path": [ "statistics" ]
				},
				"description": "Fetches high-level system statistics."
			},
			"response": []
		},
		{
			"name": "GET Dashboard Statistics (/dashboard/statastics)",
			"request": {
				"method": "GET",
				"header": [
					{ "key": "Accept", "value": "application/json" }
				],
				"url": {
					"raw": "{{base_url}}/dashboard/statastics",
					"host": [ "{{base_url}}" ],
					"path": [ "dashboard", "statastics" ]
				},
				"description": "Fetches analytics dashboard counters, revenue totals, and booking stats."
			},
			"response": []
		}
	]
}
