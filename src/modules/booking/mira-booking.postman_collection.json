{
	"info": {
		"_postman_id": "mira-booking-collection-v1",
		"name": "mira-booking",
		"description": "Postman API Collection for Mira Booking Module (/api/v1/bookings, /api/v1/payment-schedules, /api/v1/payment-records, /api/v1/payment-config).",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:5010/api/v1",
			"type": "string"
		},
		{
			"key": "token",
			"value": "YOUR_JWT_ACCESS_TOKEN_HERE",
			"type": "string"
		}
	],
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{token}}",
				"type": "string"
			}
		]
	},
	"item": [
		{
			"name": "GET Bookings List (/bookings)",
			"request": {
				"method": "GET",
				"header": [
					{ "key": "Accept", "value": "application/json" }
				],
				"url": {
					"raw": "{{base_url}}/bookings",
					"host": [ "{{base_url}}" ],
					"path": [ "bookings" ]
				},
				"description": "Fetches bookings list for user or admin."
			},
			"response": []
		},
		{
			"name": "POST Create Booking (/bookings)",
			"request": {
				"method": "POST",
				"header": [
					{ "key": "Content-Type", "value": "application/json" },
					{ "key": "Accept", "value": "application/json" }
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"journeyId\": \"cm_journey_id_here\",\n  \"startDate\": \"2026-10-01\",\n  \"guests\": 2,\n  \"specialRequests\": \"Ocean view room preferred\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/bookings",
					"host": [ "{{base_url}}" ],
					"path": [ "bookings" ]
				},
				"description": "Creates a new journey booking request."
			},
			"response": []
		},
		{
			"name": "DELETE Booking (/bookings)",
			"request": {
				"method": "DELETE",
				"header": [
					{ "key": "Content-Type", "value": "application/json" },
					{ "key": "Accept", "value": "application/json" }
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"id\": \"cm_booking_id_here\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/bookings",
					"host": [ "{{base_url}}" ],
					"path": [ "bookings" ]
				},
				"description": "Cancels or deletes a booking."
			},
			"response": []
		},
		{
			"name": "GET Payment Schedules (/payment-schedules)",
			"request": {
				"method": "GET",
				"header": [
					{ "key": "Accept", "value": "application/json" }
				],
				"url": {
					"raw": "{{base_url}}/payment-schedules",
					"host": [ "{{base_url}}" ],
					"path": [ "payment-schedules" ]
				},
				"description": "Fetches payment schedules for bookings."
			},
			"response": []
		},
		{
			"name": "GET Payment Records (/payment-records)",
			"request": {
				"method": "GET",
				"header": [
					{ "key": "Accept", "value": "application/json" }
				],
				"url": {
					"raw": "{{base_url}}/payment-records",
					"host": [ "{{base_url}}" ],
					"path": [ "payment-records" ]
				},
				"description": "Fetches transaction payment records."
			},
			"response": []
		},
		{
			"name": "GET Payment Config (/payment-config)",
			"request": {
				"method": "GET",
				"header": [
					{ "key": "Accept", "value": "application/json" }
				],
				"url": {
					"raw": "{{base_url}}/payment-config",
					"host": [ "{{base_url}}" ],
					"path": [ "payment-config" ]
				},
				"description": "Fetches booking payment rules and deposit configurations."
			},
			"response": []
		}
	]
}
