{
	"info": {
		"_postman_id": "mira-location-collection-v1",
		"name": "mira-location",
		"description": "Postman API Collection for Mira Location Module (/api/v1/locations). Manages countries, regions, destinations, and regional knowledge.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:5010/api/v1",
			"type": "string"
		},
		{
			"key": "token",
			"value": "YOUR_JWT_ACCESS_TOKEN_HERE",
			"type": "string"
		}
	],
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{token}}",
				"type": "string"
			}
		]
	},
	"item": [
		{
			"name": "GET Locations List (/locations)",
			"request": {
				"auth": { "type": "noauth" },
				"method": "GET",
				"header": [
					{ "key": "Accept", "value": "application/json" }
				],
				"url": {
					"raw": "{{base_url}}/locations",
					"host": [ "{{base_url}}" ],
					"path": [ "locations" ]
				},
				"description": "Fetches list of all destination locations."
			},
			"response": []
		},
		{
			"name": "GET Location Details by Slug (/locations?slug=albania)",
			"request": {
				"auth": { "type": "noauth" },
				"method": "GET",
				"header": [
					{ "key": "Accept", "value": "application/json" }
				],
				"url": {
					"raw": "{{base_url}}/locations?slug=albania",
					"host": [ "{{base_url}}" ],
					"path": [ "locations" ],
					"query": [
						{ "key": "slug", "value": "albania", "description": "Location slug parameter" }
					]
				},
				"description": "Fetches detailed location payload by slug."
			},
			"response": []
		},
		{
			"name": "POST Create/Update Location (/locations)",
			"request": {
				"method": "POST",
				"header": [
					{ "key": "Content-Type", "value": "application/json" },
					{ "key": "Accept", "value": "application/json" }
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"name\": \"Albania\",\n  \"slug\": \"albania\",\n  \"type\": \"COUNTRY\",\n  \"status\": \"PUBLISHED\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/locations",
					"host": [ "{{base_url}}" ],
					"path": [ "locations" ]
				},
				"description": "Creates or updates a destination location."
			},
			"response": []
		},
		{
			"name": "DELETE Location (/locations)",
			"request": {
				"method": "DELETE",
				"header": [
					{ "key": "Content-Type", "value": "application/json" },
					{ "key": "Accept", "value": "application/json" }
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"id\": \"cm_location_id_here\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/locations",
					"host": [ "{{base_url}}" ],
					"path": [ "locations" ]
				},
				"description": "Deletes location record by ID."
			},
			"response": []
		}
	]
}
