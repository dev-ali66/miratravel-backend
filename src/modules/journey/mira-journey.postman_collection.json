{
	"info": {
		"_postman_id": "mira-journey-collection-v1",
		"name": "mira-journey",
		"description": "Postman API Collection for Mira Journey Module (/api/v1/journeys). Manages luxury travel itineraries, highlights, pricing, and accommodations.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:5010/api/v1",
			"type": "string"
		},
		{
			"key": "token",
			"value": "YOUR_JWT_ACCESS_TOKEN_HERE",
			"type": "string"
		}
	],
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{token}}",
				"type": "string"
			}
		]
	},
	"item": [
		{
			"name": "GET All Journeys (/journeys)",
			"request": {
				"auth": { "type": "noauth" },
				"method": "GET",
				"header": [
					{ "key": "Accept", "value": "application/json" }
				],
				"url": {
					"raw": "{{base_url}}/journeys",
					"host": [ "{{base_url}}" ],
					"path": [ "journeys" ]
				},
				"description": "Fetches list of published journey itineraries."
			},
			"response": []
		},
		{
			"name": "GET Journey Details by Slug/ID (/journeys?slug=...)",
			"request": {
				"auth": { "type": "noauth" },
				"method": "GET",
				"header": [
					{ "key": "Accept", "value": "application/json" }
				],
				"url": {
					"raw": "{{base_url}}/journeys?slug=albanian-riviera-escape",
					"host": [ "{{base_url}}" ],
					"path": [ "journeys" ],
					"query": [
						{ "key": "slug", "value": "albanian-riviera-escape", "description": "Journey slug parameter" }
					]
				},
				"description": "Fetches full journey details including overview, daily itinerary, inclusions, and media."
			},
			"response": []
		},
		{
			"name": "POST Create/Update Journey (/journeys)",
			"request": {
				"method": "POST",
				"header": [
					{ "key": "Content-Type", "value": "application/json" },
					{ "key": "Accept", "value": "application/json" }
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"title\": \"Albanian Riviera Escape\",\n  \"slug\": \"albanian-riviera-escape\",\n  \"duration\": \"7 Days\",\n  \"price\": 2450,\n  \"status\": \"PUBLISHED\",\n  \"locationId\": \"cm_location_id_here\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/journeys",
					"host": [ "{{base_url}}" ],
					"path": [ "journeys" ]
				},
				"description": "Creates or updates journey itinerary record."
			},
			"response": []
		},
		{
			"name": "DELETE Journey (/journeys)",
			"request": {
				"method": "DELETE",
				"header": [
					{ "key": "Content-Type", "value": "application/json" },
					{ "key": "Accept", "value": "application/json" }
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"id\": \"cm_journey_id_here\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/journeys",
					"host": [ "{{base_url}}" ],
					"path": [ "journeys" ]
				},
				"description": "Deletes journey record by ID."
			},
			"response": []
		}
	]
}
