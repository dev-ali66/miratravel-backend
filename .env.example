# ==============================================================================
# POLI MIRA BACKEND - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER & APPLICATION
# ------------------------------------------------------------------------------
PORT=5010
NODE_ENV="development" # development | production
API_VERSION="v1"

# ------------------------------------------------------------------------------
# 2. DATABASE (Neon PostgreSQL)
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://username:password@ep-example.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# ------------------------------------------------------------------------------
# 3. CORS & WEBSOCKET ORIGINS
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"
SOCKET_ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# ------------------------------------------------------------------------------
# 4. EMAIL & SMTP SERVICE (Nodemailer / Gmail App Password)
# ------------------------------------------------------------------------------
EMAIL_USER="your-email@gmail.com"
EMAIL_PASS="your-16-character-app-password"
EMAIL_FROM="\"Poli Support\" <your-email@gmail.com>"

# ------------------------------------------------------------------------------
# 5. AUTHENTICATION & JWT TOKENS
# ------------------------------------------------------------------------------
# Access Token (Short-lived, in minutes)
JWT_ACCESS_TOKEN_SECRET="your-jwt-access-token-secret-key"
JWT_ACCESS_TOKEN_EXPIRES_IN="1" # Expiry in minutes (default: 1 min)

# Refresh Token & Session Duration
JWT_REFRESH_TOKEN_SECRET="your-jwt-refresh-token-secret-key"
JWT_REFRESH_TOKEN_EXPIRES_IN="1440" # JWT token payload expiry in minutes (1440 = 24 hours)
REFRESH_TOKEN_COOKIE_EXPIRE_DAYS="30" # Persistent session cookie lifetime in days (when rememberMe=true)
REFRESH_TOKEN_NON_REMEMBER_EXPIRE_MINUTES="30" # Ephemeral session lifetime in minutes (when rememberMe=false)

# Invite / Verification Token
JWT_INVITE_TOKEN_SECRET="your-jwt-invite-token-secret-key"
JWT_INVITE_TOKEN_EXPIRES_IN="10080" # Expiry in minutes (10080 = 7 days)

# ------------------------------------------------------------------------------
# 6. OTP & PASSWORD RESET
# ------------------------------------------------------------------------------
OTP_LENGTH="4" # Number of OTP digits (e.g., 4 or 6)
OTP_EXPIRE_MINUTE="10" # OTP valid duration in minutes
OTP_BASE_URL="http://localhost:5010/api/v1" # Base URL sent in verification email links
PASSWORD_RESET_EXPIRE_IN="10" # Password reset link/token expiry in minutes

# ------------------------------------------------------------------------------
# 7. SECURITY, HASHING & LOGIN LOCKOUT POLICY
# ------------------------------------------------------------------------------
BCRYPT_JS_SALT_ROUNDS="12"
LOGIN_FAILED_ATTEMPTS="3" # Max failed login attempts before locking account
LOGIN_LOCKED_UNTIL="1" # Account lockout duration in minutes
PASSWORD_LENGTH="8" # Minimum password length
DIRECT_REGISTER="TRUE" # Allow direct registration (TRUE | FALSE)
TOKEN_REGISTER="FALSE" # Require invite token for registration (TRUE | FALSE)

# ------------------------------------------------------------------------------
# 8. CLOUDINARY CDN MEDIA STORAGE (Optional / Uploads)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# ------------------------------------------------------------------------------
# 9. REDIS CACHING & SESSIONS (Optional)
# ------------------------------------------------------------------------------
REDIS_HOST="127.0.0.1"
REDIS_PORT="6379"
REDIS_TIMEOUT="500"

# ------------------------------------------------------------------------------
# 10. PAYMENT GATEWAYS (Stripe - Optional)
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
