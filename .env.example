DATABASE_URL="postgresql://USERNAME:PASSWORD@HOST/DATABASE?sslmode=require&channel_binding=require"

EMAIL_USER="your-email@gmail.com"
EMAIL_PASS="your-app-password"

PORT="5010"

JWT_ACCESS_TOKEN_SECRET="your-access-token-secret"
JWT_ACCESS_TOKEN_EXPIRES_IN="100"

JWT_REFRESH_TOKEN_SECRET="your-refresh-token-secret"
JWT_REFRESH_TOKEN_EXPIRES_IN="30"

PASSWORD_RESET_EXPIRE_IN="10"

CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

REDIS_HOST="127.0.0.1"
REDIS_PORT="6379"
REDIS_TIMEOUT="1000"

CORS_ALLOWED_ORIGINS=""
SOCKET_ALLOWED_ORIGINS=""

OTP_EXPIRE_MINUTE="10"
OTP_BASE_URL="http://localhost:5010/api/v1"

JWT_INVITE_TOKEN_SECRET="your-invite-token-secret"
JWT_INVITE_TOKEN_EXPIRES_IN="10080"

BCRYPT_JS_SALT_ROUNDS="12"

LOGIN_FAILED_ATTEMPTS="3"
LOGIN_LOCKED_UNTIL="1"

DIRECT_REGISTER="TRUE"
TOKEN_REGISTER="FALSE"

PASSWORD_LENGTH="8"