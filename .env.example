# ==========================================
# POLI MIRA BACKEND - ENVIRONMENT CONFIGURATION
# ==========================================

# Server & Environment
PORT=5010
NODE_ENV="development" # development | production

# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://username:password@ep-example.us-east-1.aws.neon.tech/neondb?sslmode=require"

# CORS & Sockets
CORS_ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000"
SOCKET_ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000"

# SMTP & Email Delivery
EMAIL_USER="your-email@gmail.com"
EMAIL_PASS="your-gmail-app-password"
EMAIL_FROM="\"Poli Support\" <your-email@gmail.com>"

# JWT & Authentication Secrets
JWT_ACCESS_TOKEN_SECRET="your-jwt-access-token-secret-key"
JWT_ACCESS_TOKEN_EXPIRES_IN="100" # Expiry in minutes

JWT_REFRESH_TOKEN_SECRET="your-jwt-refresh-token-secret-key"
JWT_REFRESH_TOKEN_EXPIRES_IN="43200" # Expiry in minutes (43200 = 30 days)
REFRESH_TOKEN_COOKIE_EXPIRE_DAYS="30" # Cookie expiry in days when rememberMe=true
REFRESH_TOKEN_NON_REMEMBER_EXPIRE_MINUTES="1" # Session expiry in minutes when rememberMe=false (e.g. 1 min for test, 1440 for 24h)

JWT_INVITE_TOKEN_SECRET="your-jwt-invite-token-secret-key"
JWT_INVITE_TOKEN_EXPIRES_IN="10080" # Expiry in minutes (10080 = 7 days)

# OTP & Password Reset
OTP_LENGTH="4" # Length of OTP digits (e.g., 4 or 6)
OTP_EXPIRE_MINUTE="10" # OTP valid duration in minutes
OTP_BASE_URL="http://localhost:5010/api/v1"
PASSWORD_RESET_EXPIRE_IN="10" # Password reset link/token expiry in minutes

# Security, Hashing & Login Policy
BCRYPT_JS_SALT_ROUNDS="12"
LOGIN_FAILED_ATTEMPTS="5" # Max failed attempts before lock
LOGIN_LOCKED_UNTIL="15" # Lock duration in minutes
PASSWORD_LENGTH="8" # Minimum password length
DIRECT_REGISTER="TRUE" # TRUE | FALSE
TOKEN_REGISTER="TRUE" # TRUE | FALSE

# Cloudinary CDN Media Storage
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# Redis Cache & Sessions (Optional)
REDIS_HOST="127.0.0.1"
REDIS_PORT="6379"
REDIS_TIMEOUT="1000"

# Payments (Stripe)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
