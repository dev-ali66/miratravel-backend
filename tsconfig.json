  "compilerOptions": {
    "incremental": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "esModuleInterop": true,
    "skipLibCheck": true,

    "rootDir": ".",
    "outDir": "./dist",

    "sourceMap": true
  },
  "exclude": ["node_modules", "dist"]
}

